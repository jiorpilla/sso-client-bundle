{
    "name": "jiorpilla/sso-client-bundle",
    "description": "Symfony bundle to sign in through an OpenID Connect SSO (Authorization Code + PKCE, local JWT verification, token refresh).",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {"name": "Jan Ivan Orpilla", "email": "jiorpilla@gmail.com"}
    ],
    "require": {
        "php": ">=8.4",
        "ext-openssl": "*",
        "lcobucci/jwt": "^5.5",
        "psr/clock": "^1.0",
        "symfony/cache-contracts": "^3.5",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/http-client-contracts": "^3.5",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/service-contracts": "^3.5"
    },
    "autoload": {
        "psr-4": {"Jiorpilla\\SsoClientBundle\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Jiorpilla\\SsoClientBundle\\Tests\\": "tests/"}
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {"phpstan/extension-installer": true}
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.3",
        "symfony/browser-kit": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/yaml": "^8.1"
    }
}
